#use_frameworks! :linkage => :static
use_modular_headers!

platform :ios, '12.0'

target 'LampsSDK_Example' do
  # 静态链接，避免 Ads-CN 等静态 xcframework 与动态 Framework 冲突
  pod 'LampsSDK', :path => '../'
  # DevTools（含穿山甲 / 优量汇调试依赖；汇川工具随 NoahSDK）
  pod 'LampsSDK/DevTools', :path => '../'

  target 'LampsSDK_Tests' do
    inherit! :search_paths
  end
end
