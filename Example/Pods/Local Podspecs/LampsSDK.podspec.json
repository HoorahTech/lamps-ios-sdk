{
  "name": "LampsSDK",
  "version": "0.1.0",
  "summary": "WebView、Bridge、激励视频与监测上报 SDK",
  "description": "LampsSDK 面向三方 App，提供 WebView 展示与 Bridge 通信、激励视频、CM/PM/XM 监测上报。\n默认包含 Core 与各渠道 Adapter 源码；广告 SDK 二进制通过 CSJ / GDT / Noah Subspec 按需拉取。",
  "homepage": "http://gitlab.hupu.com/HPBase/lamps-ios-sdk",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "yujianchao": "yujianchao@hupu.com"
  },
  "source": {
    "git": "git@gitlab.hupu.com:HPBase/lamps-ios-sdk.git",
    "tag": "0.1.0"
  },
  "platforms": {
    "ios": "12.0"
  },
  "swift_versions": "5.0",
  "default_subspecs": [
    "Core",
    "CSJAdapter",
    "GDTAdapter",
    "NoahAdapter"
  ],
  "pod_target_xcconfig": {
    "DEFINES_MODULE": "YES",
    "BUILD_LIBRARY_FOR_DISTRIBUTION": "YES"
  },
  "subspecs": [
    {
      "name": "Core",
      "source_files": [
        "LampsSDK/Classes/Public/**/*.swift",
        "LampsSDK/Classes/Core/**/*.swift",
        "LampsSDK/Classes/Config/**/*.swift",
        "LampsSDK/Classes/Web/**/*.swift",
        "LampsSDK/Classes/Report/**/*.swift",
        "LampsSDK/Classes/Reward/*.swift",
        "LampsSDK/Classes/Adapter/*.swift"
      ],
      "frameworks": [
        "Foundation",
        "UIKit",
        "WebKit",
        "AdSupport"
      ],
      "weak_frameworks": "AppTrackingTransparency"
    },
    {
      "name": "CSJAdapter",
      "dependencies": {
        "LampsSDK/Core": []
      },
      "source_files": "LampsSDK/Classes/CSJAdapter/**/*.swift"
    },
    {
      "name": "GDTAdapter",
      "dependencies": {
        "LampsSDK/Core": []
      },
      "source_files": "LampsSDK/Classes/GDTAdapter/**/*.swift"
    },
    {
      "name": "NoahAdapter",
      "dependencies": {
        "LampsSDK/Core": []
      },
      "source_files": "LampsSDK/Classes/NoahAdapter/**/*.swift"
    },
    {
      "name": "CSJ",
      "dependencies": {
        "LampsSDK/CSJAdapter": [],
        "Ads-CN": []
      }
    },
    {
      "name": "GDT",
      "dependencies": {
        "LampsSDK/GDTAdapter": [],
        "GDTMobSDK": []
      }
    },
    {
      "name": "Noah",
      "dependencies": {
        "LampsSDK/NoahAdapter": [],
        "NoahAdSdks": []
      }
    },
    {
      "name": "Ads",
      "dependencies": {
        "LampsSDK/CSJ": [],
        "LampsSDK/GDT": [],
        "LampsSDK/Noah": []
      }
    }
  ],
  "swift_version": "5.0"
}
