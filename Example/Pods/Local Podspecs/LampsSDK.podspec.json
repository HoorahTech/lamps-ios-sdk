{
  "name": "LampsSDK",
  "version": "0.1.0",
  "summary": "WebView、Bridge、激励视频与监测上报 SDK",
  "description": "LampsSDK 面向三方 App，提供 WebView 展示与 Bridge 通信、激励视频、CM/PM/XM 监测上报。\n支持源码 / 二进制两种分发；广告 SDK 通过 CSJ / GDT / Noah Subspec 按需拉取。",
  "homepage": "http://gitlab.hupu.com/HPBase/lamps-ios-sdk",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "yujianchao": "yujianchao@hupu.com"
  },
  "source": {
    "git": "git@gitlab.hupu.com:HPBase/lamps-ios-sdk.git",
    "tag": "0.1.0"
  },
  "platforms": {
    "ios": "12.0"
  },
  "swift_versions": "5.0",
  "default_subspecs": [
    "Core",
    "CSJ",
    "GDT",
    "Noah"
  ],
  "pod_target_xcconfig": {
    "DEFINES_MODULE": "YES",
    "BUILD_LIBRARY_FOR_DISTRIBUTION": "YES"
  },
  "subspecs": [
    {
      "name": "Core",
      "source_files": [
        "LampsSDK/Classes/Public/**/*.swift",
        "LampsSDK/Classes/Core/**/*.swift",
        "LampsSDK/Classes/Config/**/*.swift",
        "LampsSDK/Classes/Web/**/*.swift",
        "LampsSDK/Classes/Report/**/*.swift",
        "LampsSDK/Classes/Reward/*.swift",
        "LampsSDK/Classes/Adapter/*.swift"
      ],
      "frameworks": [
        "Foundation",
        "UIKit",
        "WebKit",
        "AdSupport",
        "SystemConfiguration",
        "CoreTelephony"
      ],
      "weak_frameworks": "AppTrackingTransparency"
    },
    {
      "name": "CSJAdapter",
      "dependencies": {
        "LampsSDK/Core": []
      },
      "source_files": "LampsSDK/Classes/CSJAdapter/**/*.{swift,m,h}"
    },
    {
      "name": "GDTAdapter",
      "dependencies": {
        "LampsSDK/Core": []
      },
      "source_files": "LampsSDK/Classes/GDTAdapter/**/*.{swift,m,h}"
    },
    {
      "name": "NoahAdapter",
      "dependencies": {
        "LampsSDK/Core": []
      },
      "source_files": "LampsSDK/Classes/NoahAdapter/**/*.{swift,m,h}"
    },
    {
      "name": "CSJ",
      "dependencies": {
        "LampsSDK/CSJAdapter": [],
        "Ads-CN/BUAdSDK": []
      }
    },
    {
      "name": "GDT",
      "dependencies": {
        "LampsSDK/GDTAdapter": [],
        "GDTMobSDK": []
      }
    },
    {
      "name": "Noah",
      "dependencies": {
        "LampsSDK/NoahAdapter": [],
        "AFNetworking": [],
        "SDWebImage": [],
        "YYModel": []
      },
      "vendored_frameworks": [
        "LampsSDK/Vendor/Noah/NoahSDK.framework",
        "LampsSDK/Vendor/Noah/Other/*.framework"
      ],
      "resources": [
        "LampsSDK/Vendor/Noah/NoahSDK.framework/*.bundle",
        "LampsSDK/Vendor/Noah/Other/**/*.bundle"
      ],
      "frameworks": [
        "CoreTelephony",
        "SystemConfiguration",
        "WebKit",
        "ImageIO",
        "Accelerate",
        "CoreServices",
        "AVKit",
        "CoreData",
        "Security",
        "CoreGraphics",
        "MobileCoreServices",
        "MessageUI",
        "SafariServices",
        "StoreKit",
        "AVFoundation",
        "MediaPlayer",
        "JavaScriptCore",
        "QuickLook",
        "CoreMotion",
        "CoreMedia",
        "CoreLocation",
        "MapKit",
        "AdSupport"
      ],
      "weak_frameworks": [
        "AppTrackingTransparency",
        "DeviceCheck"
      ],
      "libraries": [
        "c++abi",
        "sqlite3",
        "c++",
        "xml2",
        "resolv",
        "z"
      ],
      "pod_target_xcconfig": {
        "OTHER_LDFLAGS": "$(inherited) -ObjC"
      }
    },
    {
      "name": "Ads",
      "dependencies": {
        "LampsSDK/CSJ": [],
        "LampsSDK/GDT": [],
        "LampsSDK/Noah": []
      }
    },
    {
      "name": "DevTools",
      "dependencies": {
        "LampsSDK/Core": [],
        "GDTDevToolSDK": [],
        "Ads-CN/BUAdTestMeasurement": []
      },
      "source_files": "LampsSDK/Classes/Debug/**/*.{swift,m,h}"
    }
  ],
  "swift_version": "5.0"
}
