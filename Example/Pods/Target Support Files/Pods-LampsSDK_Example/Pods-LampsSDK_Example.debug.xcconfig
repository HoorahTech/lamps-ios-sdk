ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES = YES
CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
ENABLE_USER_SCRIPT_SANDBOXING = NO
EXCLUDED_ARCHS[sdk=iphonesimulator*] = arm64
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_ROOT}/../../LampsSDK/Vendor/Noah" "${PODS_ROOT}/../../LampsSDK/Vendor/Noah/Other" "${PODS_ROOT}/Ads-CN/SDK" "${PODS_ROOT}/GDTMobSDK/GDTFramework" "${PODS_XCFRAMEWORKS_BUILD_DIR}/Ads-CN/BUAdSDK" "${PODS_XCFRAMEWORKS_BUILD_DIR}/Ads-CN/BUAdTestMeasurement" "${PODS_XCFRAMEWORKS_BUILD_DIR}/GDTMobSDK"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_ROOT}/Headers/Public" "${PODS_ROOT}/Headers/Public/AFNetworking" "${PODS_ROOT}/Headers/Public/GDTDevToolSDK" "${PODS_ROOT}/Headers/Public/LampsSDK" "${PODS_ROOT}/Headers/Public/SDWebImage" "${PODS_ROOT}/Headers/Public/YYModel" ${PODS_ROOT}/GDTMobSDK/GDTFramework/GDTMobSDK.xcframework/ios-arm64/GDTMobSDK.framework/Headers ${PODS_ROOT}/GDTMobSDK/GDTFramework/Tquic.xcframework/ios-arm64_armv7/Tquic.framework/Headers
LD_RUNPATH_SEARCH_PATHS = $(inherited) /usr/lib/swift '@executable_path/Frameworks' '@loader_path/Frameworks'
LIBRARY_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/AFNetworking" "${PODS_CONFIGURATION_BUILD_DIR}/LampsSDK" "${PODS_CONFIGURATION_BUILD_DIR}/SDWebImage" "${PODS_CONFIGURATION_BUILD_DIR}/YYModel" "${PODS_ROOT}/GDTDevToolSDK/Products" "${TOOLCHAIN_DIR}/usr/lib/swift/${PLATFORM_NAME}" /usr/lib/swift
OTHER_CFLAGS = $(inherited) -fmodule-map-file="${PODS_CONFIGURATION_BUILD_DIR}/LampsSDK/LampsSDK.modulemap" -fmodule-map-file="${PODS_ROOT}/Headers/Public/AFNetworking/AFNetworking.modulemap" -fmodule-map-file="${PODS_ROOT}/Headers/Public/SDWebImage/SDWebImage.modulemap" -fmodule-map-file="${PODS_ROOT}/Headers/Public/YYModel/YYModel.modulemap"
OTHER_LDFLAGS = $(inherited) -ObjC -l"AFNetworking" -l"GDTDevToolSDK" -l"LampsSDK" -l"SDWebImage" -l"YYModel" -l"bz2" -l"c++" -l"c++abi" -l"iconv" -l"resolv" -l"sqlite3" -l"xml2" -l"z" -framework "ATokenSDK" -framework "AVFoundation" -framework "AVKit" -framework "Accelerate" -framework "AdSupport" -framework "AudioToolbox" -framework "BUAdSDK" -framework "BUAdTestMeasurement" -framework "CoreData" -framework "CoreFoundation" -framework "CoreGraphics" -framework "CoreImage" -framework "CoreLocation" -framework "CoreMedia" -framework "CoreMotion" -framework "CoreServices" -framework "CoreTelephony" -framework "CoreText" -framework "Foundation" -framework "GDTMobSDK" -framework "ImageIO" -framework "JavaScriptCore" -framework "MapKit" -framework "MediaPlayer" -framework "MessageUI" -framework "MobileCoreServices" -framework "NoahSDK" -framework "QuartzCore" -framework "QuickLook" -framework "SafariServices" -framework "Security" -framework "StoreKit" -framework "SystemConfiguration" -framework "Tquic" -framework "UIKit" -framework "UTDID" -framework "WebKit" -weak_framework "AppTrackingTransparency" -weak_framework "CoreHaptics" -weak_framework "CoreML" -weak_framework "DeviceCheck" -weak_framework "WebKit"
OTHER_MODULE_VERIFIER_FLAGS = $(inherited) "-F${PODS_CONFIGURATION_BUILD_DIR}/AFNetworking" "-F${PODS_CONFIGURATION_BUILD_DIR}/Ads-CN" "-F${PODS_CONFIGURATION_BUILD_DIR}/GDTDevToolSDK" "-F${PODS_CONFIGURATION_BUILD_DIR}/GDTMobSDK" "-F${PODS_CONFIGURATION_BUILD_DIR}/LampsSDK" "-F${PODS_CONFIGURATION_BUILD_DIR}/SDWebImage" "-F${PODS_CONFIGURATION_BUILD_DIR}/YYModel"
OTHER_SWIFT_FLAGS = $(inherited) -D COCOAPODS -Xcc -fmodule-map-file="${PODS_CONFIGURATION_BUILD_DIR}/LampsSDK/LampsSDK.modulemap" -Xcc -fmodule-map-file="${PODS_ROOT}/Headers/Public/AFNetworking/AFNetworking.modulemap" -Xcc -fmodule-map-file="${PODS_ROOT}/Headers/Public/SDWebImage/SDWebImage.modulemap" -Xcc -fmodule-map-file="${PODS_ROOT}/Headers/Public/YYModel/YYModel.modulemap"
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
SWIFT_INCLUDE_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/LampsSDK"
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
