BUILD_LIBRARY_FOR_DISTRIBUTION = YES
CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
CONFIGURATION_BUILD_DIR = ${PODS_CONFIGURATION_BUILD_DIR}/LampsSDK
DEFINES_MODULE = YES
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/AFNetworking" "${PODS_CONFIGURATION_BUILD_DIR}/BUTTSDKFramework" "${PODS_CONFIGURATION_BUILD_DIR}/SDWebImage" "${PODS_CONFIGURATION_BUILD_DIR}/YYModel" "${PODS_ROOT}/../../LampsSDK/Vendor/Noah" "${PODS_ROOT}/../../LampsSDK/Vendor/Noah/Other" "${PODS_ROOT}/Ads-CN/SDK" "${PODS_ROOT}/BUTTSDKFramework/TTSDKFramework/TTSDKCore" "${PODS_ROOT}/BUTTSDKFramework/TTSDKFramework/TTSDKLiveBase" "${PODS_ROOT}/BUTTSDKFramework/TTSDKFramework/TTSDKLivePlayerLite" "${PODS_ROOT}/BUTTSDKFramework/TTSDKFramework/TTSDKLivePullVolcLog" "${PODS_ROOT}/BUTTSDKFramework/TTSDKFramework/TTSDKPlayerCoreLiveLite" "${PODS_ROOT}/BUTTSDKFramework/TTSDKFramework/TTSDKReachability" "${PODS_ROOT}/BUTTSDKFramework/TTSDKFramework/TTSDKStrategyLite" "${PODS_ROOT}/BUTTSDKFramework/TTSDKFramework/TTSDKTTFFmpegLiveLite" "${PODS_ROOT}/BUTTSDKFramework/TTSDKFramework/TTSDKVolcLog" "${PODS_ROOT}/GDTMobSDK/GDTFramework" "${PODS_XCFRAMEWORKS_BUILD_DIR}/Ads-CN/BUAdLive" "${PODS_XCFRAMEWORKS_BUILD_DIR}/Ads-CN/BUAdSDK" "${PODS_XCFRAMEWORKS_BUILD_DIR}/BUTTSDKFramework/Core" "${PODS_XCFRAMEWORKS_BUILD_DIR}/BUTTSDKFramework/LiveBase" "${PODS_XCFRAMEWORKS_BUILD_DIR}/BUTTSDKFramework/LivePlayer/Lite" "${PODS_XCFRAMEWORKS_BUILD_DIR}/BUTTSDKFramework/LivePull-VolcLog" "${PODS_XCFRAMEWORKS_BUILD_DIR}/BUTTSDKFramework/PlayerCore/LiveLite" "${PODS_XCFRAMEWORKS_BUILD_DIR}/BUTTSDKFramework/Reachability" "${PODS_XCFRAMEWORKS_BUILD_DIR}/BUTTSDKFramework/Strategy/Lite" "${PODS_XCFRAMEWORKS_BUILD_DIR}/BUTTSDKFramework/TTFFmpeg/LiveLite" "${PODS_XCFRAMEWORKS_BUILD_DIR}/BUTTSDKFramework/VolcLog" "${PODS_XCFRAMEWORKS_BUILD_DIR}/GDTMobSDK"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
OTHER_LDFLAGS = $(inherited) -ObjC
OTHER_SWIFT_FLAGS = $(inherited) -D COCOAPODS
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_DEVELOPMENT_LANGUAGE = ${DEVELOPMENT_LANGUAGE}
PODS_ROOT = ${SRCROOT}
PODS_TARGET_SRCROOT = ${PODS_ROOT}/../..
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
PRODUCT_BUNDLE_IDENTIFIER = org.cocoapods.${PRODUCT_NAME:rfc1034identifier}
SKIP_INSTALL = YES
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
